# Copy to .env for local runs (dev-server.js loads it). Never commit real keys.
# On Vercel, set these in Project Settings > Environment Variables instead.

# Qloo API key from the hackathon. Leave empty to run on demo data.
QLOO_API_KEY=
# Optional. Defaults to https://api.qloo.com. Set this if Qloo gave you a different host.
QLOO_BASE_URL=https://api.qloo.com

# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty to use the scripted planner.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite (fastest). gemini-3.8-flash writes richer reasons.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional tuning
# QLOO_RESTAURANT_TAG=urn:tag:genre:place:restaurant
# MOCK_LATENCY_MS=70
# RATE_LIMIT=off
# RATE_LIMIT_PLAN=30
# RATE_LIMIT_REPLAN=90
